{
	"name": "flipword",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler d1 migrations apply flipword --remote && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply flipword --local",
		"db:migrate:remote": "wrangler d1 migrations apply flipword --remote",
		"db:backup": "mkdir -p backups && wrangler d1 export flipword --remote --output backups/flipword-$(date +%Y%m%d-%H%M%S).sql"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@hono/zod-validator": "^0.9.1",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@tanstack/react-query": "^5.105.0",
		"better-auth": "^1.7.14",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"fzstd": "^0.1.1",
		"hono": "^4.13.14",
		"i18next": "^26.5.11",
		"lucide-react": "^1.62.0",
		"papaparse": "^5.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.9",
		"react-router": "^8.5.1",
		"sql.js": "^1.15.2",
		"ts-fsrs": "^5.4.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.66.0",
		"@cloudflare/vitest-plugin": "^1.4.10",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/sql.js": "^1.4.11",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"oxlint": "^1.88.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	}
}
